# written by HYDROLIB-core 0.8.1

[Geometry]
netFile               = planar1d_net.nc # *_net.nc
iniFieldFile          = inifields.ini   # Initial and parameter field file <*.ini>.
uniformWidth1D        = 2.0             # Uniform width for 1D profiles not specified bij profloc
waterLevIni           = -999.0          # Initial water level
bedLevUni             = -5.0            # Uniform bed level, (only if bedlevtype>=3, used at missing z values in netfile
bedSlope              = 0.0             # bedslopeinclination, sets zk = bedlevuni + x*bedslope ans sets zbndz = xbndz*bedslope
bedLevType            = 3               # 1: at cell center (tiles xz,yz,bl,bob=max(bl)), 2: at face (tiles xu,yu,blu,bob=blu), 3: at face (using mean node values), 4: at face (using min node values), 5: at face (using max node values), 6: with bl based on node values
blMeanBelow           = -999.0          # if not -999d0, below this level the cell centre bedlevel is the mean of surrouding netnodes
blMinAbove            = -999.0          # if not -999d0, above this level the cell centre bedlevel is the min of surrouding netnodes
angLat                = 0.0             # Angle of latitude  S-N (deg), 0=no Coriolis
angLon                = 0.0             # Angle of longitude E-W (deg), 0=Greenwich
conveyance2D          = -1              # -1:R=HU,0:R=H, 1:R=A/P, 2:K=analytic-1D conv, 3:K=analytic-2D conv
nonlin2D              = 0               # Non-linear 2D volumes, only icm ibedlevtype = 3 and Conveyance2D>=1
sillHeightMin         = 0.5             # Weir treatment only if both sills larger than this value (m)
makeOrthoCenters      = 0               # 1=yes, 0=no switch from circumcentres to orthocentres in geominit
dCenterInside         = 1.0             # limit cell center; 1.0:in cell <-> 0.0:on c/g
baMin                 = 1e-06           # Minimum gridcell area , icm cutcells
openBoundaryTolerance = 3.0             # Search tolerance factor between boundary polyline and grid cells. Unit: in cell size units (i.e., not metres).
renumberFlowNodes     = 1               # Switch on or off (1/0) the renumbering of flow nodes for slight speedup.
kmx                   = 0               # Max nr of vertical layers
layerType             = 1               # 1= all sigma, 2 = all z, 3 = use VertplizFile
numTopSig             = 0               # Nr of sigmalayers in top of Zlayer model
sigmaGrowthFactor     = 1.0             # layer thickness growth factor from bed up
uniformHeight1D       = 20.0            # Uniform width for 1D profiles not specified bij profloc

[Numerics]
CFLMax                   = 0.7    # Max. Courant nr.
advecType                = 3      # Adv type, 0=no, 1= Wenneker, qu-udzt, 2=1, q(uio-u), 3=Perot q(uio-u), 4=Perot q(ui-u), 5=Perot q(ui-u) without itself
timeStepType             = 2      # 0=only transport, 1=transport + velocity update, 2=full implicit step_reduce, 3=step_jacobi, 4=explicit
limTypHu                 = 0      # Limiter type for waterdepth in continuity eq., 0=no, 1=minmod,2=vanLeer,3=Kooren,4=Monotone Central
limTypMom                = 4      # Limiter type for cell center advection velocity, 0=no, 1=minmod,2=vanLeer,3=Kooren,4=Monotone Central
limTypSa                 = 4      # Limiter type for salinity transport,           0=no, 1=minmod,2=vanLeer,3=Kooren,4=Monotone Central
icgSolver                = 4      # Solver type , 1 = sobekGS_OMP, 2 = sobekGS_OMPthreadsafe, 3 = sobekGS, 4 = sobekGS + Saadilud, 5 = parallel/global Saad, 6 = parallel/Petsc, 7 = parallel/GS
maxDegree                = 6      # Maximum degree in Gauss elimination
fixedWeirScheme          = 0      # 0 = no, 1 = compact stencil, 2 = whole tile lifted, full subgrid weir + factor
fixedWeirContraction     = 1.0    # flow width = flow width*FixedWeirContraction
izBndPos                 = 0      # Position of z boundary, 0=D3Dflow, 1=on net boundary, 2 = on specifiend polyline
tlfSmo                   = 0.0    # Fourier smoothing time on waterlevel boundaries (s)
slopeDrop2D              = 0.3    # Apply droplosses only if local bottom slope > Slopedrop2D, <=0 =no droplosses
chkAdvd                  = 0.0    # Check advection terms if depth < chkadvdp, => less setbacks
teta0                    = 0.55   # Teta of time integration, 0.5 < Teta < 1d0
cstBnd                   = 0      # Delft-3D type velocity treatment near boundaries for small coastal models (1) or not (0)
maxitVerticalForesterSal = 100    # 0 : no vertical filter, > 0 = Max nr of iterations
maxitVerticalForesterTem = 0      # 0 : no vertical filter for temp, > 0 = Max nr of iterations
turbulenceModel          = 3      # 0=no, 1 = constant, 2 = algebraic, 3 = k-eps, 4 = k-tau
turbulenceAdvection      = 3      # 0=no, 3 = hor. expl., vert. impl.
antiCreep                = 0      # Include anti-creep calculation, (0=no, 1=yes)
maxWaterLevelDiff        = 0.0    # upper bound (in m) on water level changes, <= 0: no bounds
maxVelocityDiff          = 0.0    # upper bound (in m/s) on velocity changes, <= 0: no bounds
epsHu                    = 0.0001 # Input for threshold water depth for wet and dry cells
verticalAdvectionType = centralImplicit      # Vertical advection type for salinity, 0=No, 1=UpwexpL, 2=Centralexpl, 3=UpwimpL, 4=CentraLimpL, 5=4 but 3 for neg. stratif., 6=higher order expl, no forester
fixedWeirTopFrictCoef    = -999.0 # Uniform friction coefficient of the groyne part of fixed weirs
fixedWeirTopWidth        = 3.0    # Uniform width of the groyne part of fixed weirs
fixedWeirTalud           = 0.25   # Uniform talud slope of fixed weirs
lincontin                = 0      # Default 0; Set to 1 for linearizing d(Hu)/dx; link to AdvecType
jbasqbnddownwindhs       = 0      # 0 : original hu on qbnd, 1 = downwind hs on qbnd
horadvtypzlayer          = 0      # Horizontal advection treatment zlayer, 1=default, 2 = Sigma like
fixedweirfrictscheme     = 1      # Fixed weir friction scheme (0: friction based on hu, 1: friction based on subgrid weir friction scheme)
drop3d                   = 0.0    # Apply droplosses in 3D if z upwind below bob + 2/3 hu*drop3D

[Physics]
unifFrictCoef              = 0.0     # Uniform friction coefficient, 0=no friction
unifFrictType              = 0       # 0=Chezy, 1=Manning, 2=White Colebrook, 3=idem, WAQUA style
unifFrictCoef1D            = 0.0     # Uniform friction coefficient in 1D links, 0=no friction
unifFrictCoefLin           = 0.0     # Uniform linear friction coefficient for ocean models (m/s), 0=no
vicouv                     = 0.0     # Uniform horizontal eddy viscosity (m2/s)
dicouv                     = 0.0     # Uniform horizontal eddy diffusivity (m2/s)
vicoww                     = 0.0     # Uniform vertical eddy viscosity  (m2/s)
dicoww                     = 0.0     # Uniform vertical eddy diffusivity  (m2/s)
vicwminb                   = 0.0     # Minimum visc in prod and buoyancy term (m2/s)
smagorinsky                = 0.0     # Add Smagorinsky horizontal turbulence : vicu = vicu + ( (Smagorinsky*dx)**2)*S, e.g. 0.1
elder                      = 0.0     # Add Elder contribution                : vicu = vicu + Elder*kappa*ustar*H/6),   e.g. 1.0
irov                       = 0       # 0=free slip, 1 = partial slip using wall_ks
wall_ks                    = 0.0     # Nikuradse roughness for side walls, wall_z0=wall_ks/30
rhomean                    = 1000.0  # Average water density (kg/m3)
idensform                  = 0       # Density calulation (0: uniform, 1: Eckard, 2: Unesco, 3: baroclinic case)
ag                         = 9.81    # Gravitational acceleration
tidalForcing               = 0       # Tidal forcing (0=no, 1=yes) (only for jsferic == 1)
doodsonStart               = 55.565  # TRIWAQ =  55.565D0     , D3D =  57.555D0
doodsonStop                = 375.575 # TRIWAQ = 375.575D0     , D3D = 275.555D0
doodsonEps                 = 0.03    # TRIWAQ = 0.0  400 cmps , D3D = 0.03   60 cmps
salinity                   = 0       # Include salinity, (0=no, 1=yes)
initialSalinity            = 31.0    # Inital salinity concentration (ppt)
sal0AboveZLev              = -999.0  # Salinity 0 above level (m)
deltaSalinity              = -999.0  # for testcases
backgroundSalinity         = 30.0    # For eq of state (ppt)
temperature                = 0       # Include temperature, (0=no, 1=only transport, 3=excess model of D3D, 5=heat flux model (5) of D3D)
initialTemperature         = 6.0     # Inital temperature (degC)
backgroundWaterTemperature = 6.0     # For eq of state (deg C)
secchiDepth                = 1.0     # Water clarity parameter (m)
stanton                    = -1.0    # Coefficient for convective heat flux ( ) , if negative, Cd wind*abs(Stanton)
dalton                     = -1.0    # Coefficient for evaporative heat flux ( ), if negative, Cd wind*abs(Dalton)
secondaryFlow              = 0       # Secondary flow (0=no, 1=yes)
betaSpiral                 = 0.0     # Factor for weighing the effect of the spiral flow on flow dispersion stresses
umodlin                    = 0.0     # Use 1 for linear friction umod, for ifrctyp=4,5,6

[Wind]
iCdTyp               = 2                # ( ),1=const, 2=S&B 2 breakpoints, 3= S&B 3 breakpoints, 4=Charnock constant
CdBreakpoints        = 0.00063 0.00723  # ( ),   e.g. 0.00063  0.00723
windSpeedBreakpoints = 0.0 100.0        # (m/s), e.g. 0.0      100.0
rhoAir               = 1.20000004768372 # Air density (kg/m3)
pavBnd               = 101325.0         # Average air pressure on open boundaries, (N/m2), only applied if value > 0
pavIni               = 0.0              # Average air pressure for initial water level correction (N/m2) (only applied if > 0)

[Waves]
waveModelNr   = 0     # Wave model nr, 0=no, 1=fetch/depth limited hurdlestive, 2=youngverhagen, 3 = Delft3D-WAVE, 4=wave group forcing
gammaX        = 1.0   # Maximum wave height/water depth ratio

[Time]
refDate = 20010101 # Reference date (yyyymmdd)
tZone   = 0.0      # Data Sources in GMT are interrogated with time in minutes since refdat-Tzone*60
tUnit   = S        # Time units in MDU (D, H, M or S), only for Tstart and Tstop
dtUser  = 2.0      # User timestep in seconds (interval for external forcing update & his/map output)
dtNodal = 0.0      # Timestep (days) for updating nodal factors in astronomical boundary conditions
dtMax   = 1.0      # Max timestep in seconds
dtInit  = 1.0      # Initial timestep in seconds
tStart  = 0.0      # Start time w.r.t. RefDate (in TUnit)
tStop   = 600.0    # Stop  time w.r.t. RefDate (in TUnit)

[Restart]

[External Forcing]
extForceFileNew = iniwaterlevel-new.ext # New format for external forcings file *.ext, link with bc     -format boundary conditions specification

[Trachytopes]
trtRou = N # Include alluvial and vegetation roughness (trachytopes), (N=no, Y=yes)

[Output]
outputDir                         = dflowfmoutput        # Output directory of map-, his-, rst-, dat- and timings-files, default: DFM_OUTPUT_<modelname>. Set to . for no dir/current dir.
obsFile                           = obslocations_obs.xyn # *.xyn Coords+name of observation stations.
hisInterval                       = 2.0                  # History output, given as "interval" "start period" "end period" (s)
mapInterval                       = 2.0                  # Map file output, given as "interval" "start period" "end period" (s)
mapFormat                         = 4                    # Map file format, 1: netCDF, 2: Tecplot, 3: netCFD and Tecplot, 4: NetCDF-UGRID
wrihis_balance                    = 1                    # Write mass balance totals to his file (1=yes, 0=no)
wrihis_structure_gen              = 1                    # Write general structure parameters to his file (1=yes, 0=no)
wrihis_structure_dam              = 1                    # Write dam parameters to his file (1=yes, 0=no)
wrihis_structure_pump             = 1                    # Write pump parameters to his file (1=yes, 0=no)
wrihis_structure_gate             = 1                    # Write gate parameters to his file (1=yes, 0=no)
wrimap_waterLevel_s0              = 1                    # Write water levels for previous time step to map file (1=yes, 0=no)
wrimap_waterLevel_s1              = 1                    # Write water levels to map file (1=yes, 0=no)
wrimap_velocity_component_u0      = 1                    # Write velocity component for previous time step to map file (1=yes, 0=no)
wrimap_velocity_component_u1      = 1                    # Write velocity component to map file (1=yes, 0=no)
wrimap_velocity_vector            = 1                    # Write cell-center velocity vectors to map file (1=yes, 0=no)
wrimap_upward_velocity_component  = 1                    # Write upward velocity component on cell interfaces (1=yes, 0=no)
wrimap_density_rho                = 1                    # Write flow density to map file (1=yes, 0=no)
wrimap_horizontal_viscosity_viu   = 1                    # Write horizontal viscosity to map file (1=yes, 0=no)
wrimap_horizontal_diffusivity_diu = 1                    # Write horizontal diffusivity to map file (1=yes, 0=no)
wrimap_flow_flux_q1               = 1                    # Write flow flux to map file (1=yes, 0=no)
wrimap_spiral_flow                = 1                    # Write spiral flow to map file (1=yes, 0=no)
wrimap_numLimdt                   = 1                    # Write the number times a cell was Courant limiting to map file (1=yes, 0=no)
wrimap_tauCurrent                 = 1                    # Write the shear stress to map file (1=yes, 0=no)
wrimap_chezy                      = 1                    # Write the chezy roughness to map file (1=yes, 0=no)
wrimap_turbulence                 = 1                    # Write vicww, k and eps to map-file (1=yes, 0=no, default=1)
wrimap_wind                       = 1                    # Write wind velocities to map file (1=yes, 0=no)
wrimap_heat_fluxes                = 0                    # Write heat fluxes to map file (1=yes, 0=no)
fullGridOutput                    = 0                    # 0:compact, 1:full time-varying grid data
eulerVelocities                   = 0                    # 0:GLM, 1:Euler velocities
richardsonOnOutput                = 0                    # 1=yes,0=no

[Grw]
Conductivity = 0.0               # non dimensionless K conductivity   saturated (m/s), Q = K*A*i (m3/s)
h_aquiferuni = 20.0              # uniform height of carrying layer (m)
h_unsatini   = 0.200000002980232 # initial level groundwater is bedlevel - h_unsatini (m)

[Model]
program          = D-Flow FM     # The program
version          = 1.1.148.41436 # The version of the program
autoStart        = 0             # Autostart simulation after loading MDU or not (0=no, 1=autostart, 2=autostartstop).

